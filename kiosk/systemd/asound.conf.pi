# Kerchunk kiosk audio (install to /etc/asound.conf).
#
# The connected HDMI display on this Pi reports NO audio sink (empty EDID/ELD)
# and its speakers sounded terrible, so audio is routed to the 3.5mm headphone
# jack (ALSA card "Headphones"), which has a real hardware volume control ('PCM',
# set via `amixer -c <card> sset PCM <pct>%` and persisted with `alsactl store`).
# `plug` upmixes rtl_fm's 12kHz mono to the jack's format/rate.
#
# To use HDMI audio instead (only if your display actually supports it — check
# that `cat /proc/asound/card<N>/eld#0.0` is non-empty), point slave.pcm at
# `plughw:CARD=vc4hdmiN,DEV=0`.
pcm.kerchunk {
    type plug
    slave.pcm "plughw:CARD=Headphones,DEV=0"
}
