# Ubuntu laptop appliance variant of kerchunk-kiosk.service.
#
# Differences from the Pi unit:
#   - runs as the machine's `kiosk` user straight from the repo checkout —
#     this machine is both the dev box and the appliance, so "deploy" is
#     `git pull && npm run build && systemctl restart kerchunk-kiosk`;
#   - KERCHUNK_ENGINE=wideband: this appliance exists to run the wideband
#     engine (the in-repo default stays rtlfm for the Pi fallback);
#   - /usr/bin/node is Ubuntu's archive nodejs (>=20 satisfied by 22.x).
#
# Installed by setup-kiosk-ubuntu.sh as /etc/systemd/system/kerchunk-kiosk.service.

[Unit]
Description=Kerchunk Kiosk backend (wideband)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=audio plugdev
WorkingDirectory=/home/kiosk/kerchunk-kiosk/kiosk
Environment=PORT=8080
Environment=KERCHUNK_CONFIG=/var/lib/kerchunk-kiosk/config.json
Environment=KERCHUNK_STATIC=/home/kiosk/kerchunk-kiosk/kiosk/dist/frontend
Environment=KERCHUNK_ENGINE=wideband
ExecStart=/usr/bin/node /home/kiosk/kerchunk-kiosk/kiosk/dist/backend/index.js
Restart=on-failure
RestartSec=2
StateDirectory=kerchunk-kiosk

[Install]
WantedBy=multi-user.target
