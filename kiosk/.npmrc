# @jeremyfuksa/campfire@2 declares a peerOptional dependency on zod@^4, but this
# project pins zod@^3. Because the peer is OPTIONAL, the version mismatch is
# harmless at runtime — but npm's strict peer resolver (npm ci / npm install)
# aborts with ERESOLVE on it. legacy-peer-deps tells npm to use the pre-v7
# resolution behavior and accept the optional peer, unblocking installs in CI
# and locally without changing any actual dependency versions.
legacy-peer-deps=true
