{
  "name": "kerchunk-kiosk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.json && cp src/backend/engine/wideband_helper.py src/backend/engine/wideband_dsp_math.py dist/backend/engine/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "start": "node dist/backend/index.js",
    "test": "vitest run",
    "test:py": "/usr/bin/python3 test/wideband_dsp_math_test.py",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jeremyfuksa/campfire": "^2.0.0",
    "lucide-static": "^1.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
