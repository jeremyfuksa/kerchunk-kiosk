{
  "name": "kerchunk-kiosk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend && npm run build:native:dist",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "start": "node dist/backend/index.js",
    "test": "vitest run",
    "build:native": "cmake -S native -B native/build && cmake --build native/build --parallel 2",
    "build:native:dist": "cmake -S native -B native/build && cmake --build native/build --parallel 2 --target kerchunk-dsp && cp native/build/kerchunk-dsp dist/backend/engine/kerchunk-dsp.new && mv -f dist/backend/engine/kerchunk-dsp.new dist/backend/engine/kerchunk-dsp",
    "test:native": "npm run build:native && native/build/kerchunk-dsp-tests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-static": "^1.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
